# Cognee Cloud (leave blank to use local Cognee)
COGNEE_URL=
COGNEE_API_KEY=
COGNEE_DATASET=blast_radius

# Local Cognee needs an LLM key when not using Cognee Cloud
LLM_API_KEY=

# Bright Data (flight status). Skip if DEMO_FLIGHT_STATUS is set.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
DEMO_FLIGHT_STATUS=Delayed 5 hours — estimated arrival 22:40 PDT

# Agent model: "openai", "anthropic", or "bedrock" (default)
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (only needed when MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# AWS Bedrock (only needed when MODEL_PROVIDER=bedrock)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
